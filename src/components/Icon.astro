---
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'h-6 w-6' } = Astro.props;

const paths: Record<string, string> = {
  home: 'M3 11l9-8 9 8M5 10v10h14V10M9 20v-6h6v6',
  building: 'M6 21V5a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v16M9 8h1M14 8h1M9 12h1M14 12h1M9 16h1M14 16h1M3 21h18',
  map: 'M9 4l-6 2.5v13.5l6-2.5 6 2.5 6-2.5V3.5l-6 2.5-6-2.5zM9 4v14m6-11.5v14',
  phone: 'M4 5c0-1 1-2 2-2h2.3c.5 0 1 .4 1.1.9l1 3.6c.1.5-.1 1-.5 1.3L8.4 9.9a12.5 12.5 0 0 0 5.7 5.7l1.1-1.5c.3-.4.8-.6 1.3-.5l3.6 1c.5.1.9.6.9 1.1V18c0 1.1-.9 2-2 2h-1C10.5 20 4 13.5 4 6V5z',
  mail: 'M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1zm0 0l8 7 8-7',
  clock: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
  shield: 'M12 3l7 3v5c0 4.5-3 8.2-7 9.5-4-1.3-7-5-7-9.5V6l7-3z',
  check: 'M5 13l4 4L19 7',
};

const d = paths[name] ?? paths.check;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d}></path>
</svg>
