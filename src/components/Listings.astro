---
import Icon from './Icon.astro';
import type { SiteConfig } from '../config/site.types';

interface Props {
  config: SiteConfig;
}
const { config } = Astro.props;
---

<section id="propiedades" class="section">
  <h2 class="section-heading">{config.listings.heading}</h2>
  <p class="section-subheading">{config.listings.subheading}</p>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {config.listings.items.map((item) => (
      <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary-light text-primary">
            <Icon name={item.icon} class="h-6 w-6" />
          </div>
          <span class="rounded-full bg-ink/5 px-3 py-1 text-xs font-medium text-ink/60">{item.badge}</span>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-ink">{item.title}</h3>
        <p class="text-ink/60">{item.zone}</p>
        <div class="mt-3 flex items-center justify-between">
          <span class="rounded-full bg-primary/10 px-3 py-1 text-sm font-semibold text-primary">{item.operation}</span>
          <span class="font-heading text-lg font-bold text-ink">{item.price}</span>
        </div>
        <p class="mt-3 text-sm text-ink/60">{item.detail}</p>
      </div>
    ))}
  </div>
</section>
