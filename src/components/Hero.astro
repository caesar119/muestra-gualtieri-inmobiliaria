---
import Icon from './Icon.astro';
import type { SiteConfig } from '../config/site.types';

interface Props {
  config: SiteConfig;
}
const { config } = Astro.props;
---

<section id="inicio" class="relative overflow-hidden bg-primary-light/40">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-14 sm:px-8 sm:py-20 lg:grid-cols-2 lg:gap-16 lg:py-24">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">{config.hero.eyebrow}</p>
      <h1 class="mt-3 font-heading text-4xl font-bold leading-tight text-ink sm:text-5xl lg:text-[3.1rem]">
        {config.hero.title}
      </h1>
      <p class="mt-5 max-w-xl text-lg text-ink/70">
        {config.hero.subtitle}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={config.hero.ctaHref} class="btn-primary">
          {config.hero.ctaLabel}
        </a>
        <a href={config.hero.secondaryHref} class="btn-outline">
          {config.hero.secondaryLabel}
        </a>
      </div>
      <p class="mt-6 flex items-center gap-2 text-sm text-ink/60">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-green-500" aria-hidden="true"></span>
        {config.meta.city}, {config.meta.province}
      </p>
    </div>

    <div class="rounded-3xl border border-black/5 bg-white p-8 shadow-xl">
      <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-light text-primary">
        <Icon name="building" class="h-8 w-8" />
      </div>
      <ul class="mt-6 space-y-4">
        {config.hero.trustPoints.map((point) => (
          <li class="flex items-start gap-3 text-ink/80">
            <Icon name="check" class="mt-0.5 h-5 w-5 flex-shrink-0 text-primary" />
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
